<!DOCTYPE html>
<!-- Habab modifications: application branding and launch-screen attribution. -->
<html>
  <head>
    <title>Habab Home Assistant</title>
    <script>window.name = "ha-main-window";</script>
    <meta charset="utf-8" />
    <link rel="manifest" href="<%= hassUrl %>/manifest.json" crossorigin="use-credentials" />
    <link rel="icon" type="image/svg+xml" href="/static/habab/habab.svg" />
    <link rel="icon" sizes="any" href="/static/habab/habab.ico" />
    <link rel="mask-icon" href="/static/habab/habab-mask.svg" color="#155e4b" />
    <link rel="icon" type="image/png" sizes="32x32" href="/static/habab/habab-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/static/habab/habab-192.png" />
    <% for (const entry of latestEntryJS) { %>
      <link rel="modulepreload" href="<%= entry %>" crossorigin="use-credentials" />
    <% } %>
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/static/habab/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Habab Home Assistant" />
    <meta name="application-name" content="Habab Home Assistant" />
    <meta
      name="msapplication-square70x70logo"
      content="/static/habab/habab-192.png"
    />
    <meta
      name="msapplication-square150x150logo"
      content="/static/habab/habab-192.png"
    />
    <meta
      name="msapplication-square310x310logo"
      content="/static/habab/habab-512.png"
    />
    <meta name="msapplication-TileColor" content="#155e4b" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="referrer" content="same-origin" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="theme-color" content="#155e4b" />
    <%= renderTemplate("_social_meta.html.template") %>
    <style>
      html {
        background-color: var(--primary-background-color, #fafafa);
        color: var(--primary-text-color, #212121);
        /* Prevent iOS Safari from inflating text when rotating to landscape */
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }
      @media (prefers-color-scheme: dark) {
        html {
          background-color: var(--primary-background-color, #111111);
          color: var(--primary-text-color, #e1e1e1);
        }
      }
      body {
        font-family: Roboto, Noto, sans-serif;
        -moz-osx-font-smoothing: grayscale;
        -webkit-font-smoothing: antialiased;
        font-weight: 400;
        height: 100vh;
        margin: 0;
        padding: 0;
      }
      #ha-launch-screen {
        font-family: ui-sans-serif, system-ui, sans-serif;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        user-select: none;
        -webkit-user-select: none;
        transition: opacity var(--ha-animation-duration-normal, 250ms) ease-out;
      }
      #ha-launch-screen.removing {
        opacity: 0;
      }
      @keyframes launch-lockup-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      #ha-launch-screen .ha-lockup {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        animation: launch-lockup-in var(--ha-animation-duration-normal, 250ms) ease-out both;
      }
      #ha-launch-screen-info-box > *,
      #ha-launch-screen .habab-attribution {
        animation: launch-lockup-in var(--ha-animation-duration-normal, 250ms) ease-out both;
      }
      #ha-launch-screen .ha-logo {
        width: 96px;
        height: 96px;
      }
      #ha-launch-screen .ha-launch-screen-spacer-top {
        flex: 1;
        margin-top: calc( 2 * max(var(--safe-area-inset-top, 0px), 48px) + 46px );
        padding-top: 48px;
      }
      #ha-launch-screen .ha-launch-screen-spacer-bottom {
        flex: 1;
        padding-top: 16px;
      }
      .habab-attribution {
        margin: max(var(--safe-area-inset-bottom, 0px), 16px) 0;
        color: inherit;
        font-size: 12px;
        line-height: 16px;
      }
      @media (max-height: 560px) {
        #ha-launch-screen .ha-launch-screen-spacer-top {
          margin-top: 24px;
          padding-top: 24px;
        }
        #ha-launch-screen .ha-launch-screen-spacer-bottom {
          padding-top: 16px;
        }
      }
    </style>
  </head>
  <body>
    <div id="ha-launch-screen">
      <div class="ha-launch-screen-spacer-top"></div>
      <div class="ha-lockup">
        <img class="ha-logo" src="/static/habab/habab.svg" alt="Habab Home Assistant">
      </div>
      <div id="ha-launch-screen-info-box" class="ha-launch-screen-spacer-bottom"></div>
      <a class="habab-attribution" href="https://habab.ru">Сделано в habab.ru</a>
    </div>
    <ha-demo></ha-demo>
    <%= renderTemplate("../../../src/html/_js_base.html.template") %>
    <%= renderTemplate("../../../src/html/_preload_roboto.html.template") %>
    <%= renderTemplate("../../../src/html/_script_loader.html.template") %>
<script>
      (() => {
        const params = new URLSearchParams(window.location.search);
        const shouldEnable = params.get("dev_inspect") === "1";
        let loading = false;

        const loadInspector = (enableAfterLoad) => {
          if (window.DevInspect) {
            if (enableAfterLoad) window.DevInspect.enable();
            return;
          }
          if (loading) return;
          loading = true;

          const script = document.createElement("script");
          script.async = true;
          script.src = "https://op.wpmix.net/embed.js";
          script.integrity = "sha256-HICOTHvVU35lGtBA+jMBomP8mgvMi3ZdwpmHYF8YKbw=";
          script.crossOrigin = "anonymous";
          script.dataset.app = "habab-home";
          script.addEventListener("load", () => {
            if (enableAfterLoad) window.DevInspect?.enable();
          }, { once: true });
          script.addEventListener("error", () => {
            loading = false;
          }, { once: true });
          document.head.append(script);
        };

        if (shouldEnable) {
          loadInspector(false);
        }

        document.addEventListener("keydown", (event) => {
          if (
            !event.ctrlKey ||
            !event.shiftKey ||
            event.key.toLowerCase() !== "d" ||
            (event.target instanceof HTMLElement &&
              (event.target.isContentEditable ||
                event.target.closest("input, textarea, select, [contenteditable]")))
          ) {
            return;
          }

          event.preventDefault();
          event.stopImmediatePropagation();
          if (window.DevInspect) {
            window.DevInspect.toggle();
          } else {
            loadInspector(true);
          }
        });
      })();
    </script>
  </body>
</html>
