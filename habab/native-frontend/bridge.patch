+import process from "node:process";
+import rspackConfig from "../../build-scripts/rspack.cjs";
+
+const originalWorkers = process.env.HABAB_TERSER_WORKERS;
+const { getTerserParallelism } = rspackConfig;
+
+afterEach(() => {
+  if (originalWorkers === undefined) {
+    delete process.env.HABAB_TERSER_WORKERS;
+  } else {
+    process.env.HABAB_TERSER_WORKERS = originalWorkers;
+  }
+});
+
+describe("Terser worker configuration", () => {
+  it("keeps Rspack's default parallel worker selection when unset", () => {
+    delete process.env.HABAB_TERSER_WORKERS;
+
+    expect(getTerserParallelism()).toBe(true);
+  });
+
+  it("accepts a positive integer worker count", () => {
+    process.env.HABAB_TERSER_WORKERS = "1";
+
+    expect(getTerserParallelism()).toBe(1);
+  });
+
+  it.each(["", "0", "-1", "1.5", "many", "9007199254740992"])(
+    "rejects invalid worker count %s",
+    (value) => {
+      process.env.HABAB_TERSER_WORKERS = value;
+
+      expect(() => getTerserParallelism()).toThrow(
+        "HABAB_TERSER_WORKERS must be a positive integer"
+      );
+    }
+  );
+});
