# Published image path: same pinned Home Assistant Core base as Dockerfile,
# with a same-source native frontend wheel and the pinned OpenCode executable
# embedded for the target architecture.
FROM ghcr.io/home-assistant/home-assistant:2026.10.2@sha256:33afb0659d786213264c2211f8d91c5fe87461c56eba6a3a546eb05fc71e89f4

ARG TARGETARCH
ARG HABAB_SOURCE_REVISION
ARG HABAB_FRONTEND_VERSION
ARG HABAB_FRONTEND_SHA256

LABEL org.opencontainers.image.title="Habab Home" \
      org.opencontainers.image.version="0.3.6" \
      org.opencontainers.image.description="Local Home Assistant Core distribution maintained by Habab" \
      org.opencontainers.image.source="https://github.com/marsiandeployer/habab-home-assistant" \
      org.opencontainers.image.revision="${HABAB_SOURCE_REVISION}" \
      io.habab.source.dirty="false" \
      io.habab.frontend.version="${HABAB_FRONTEND_VERSION}" \
      io.habab.frontend.sha256="${HABAB_FRONTEND_SHA256}"

RUN apk add --no-cache nodejs=24.22.1-r0

COPY frontend-candidate/ /opt/habab-frontend-candidate/
RUN set -eu; \
    wheel="/opt/habab-frontend-candidate/home_assistant_frontend-${HABAB_FRONTEND_VERSION}-py3-none-any.whl"; \
    test -f "$wheel"; \
    printf '%s  %s\n' "$HABAB_FRONTEND_SHA256" "$wheel" | sha256sum -c -; \
    python3 -m pip install --no-deps --no-index --disable-pip-version-check "$wheel"; \
    rm -rf /opt/habab-frontend-candidate

COPY src/habab_home /usr/src/homeassistant/homeassistant/components/habab_home
COPY src/habab_telegram /usr/src/homeassistant/homeassistant/components/habab_telegram
COPY src/habab_yandex_speech /usr/src/homeassistant/homeassistant/components/habab_yandex_speech
COPY src/idigital_sms /usr/src/homeassistant/homeassistant/components/idigital_sms
COPY telegram-agent /opt/habab-telegram
COPY config/configuration.yaml /usr/local/share/habab-home/configuration.yaml
COPY docker-entrypoint.sh /usr/local/bin/habab-home-entrypoint
COPY docker-entrypoint-release.sh /usr/local/bin/habab-home-release-entrypoint
COPY habab-ha.py /usr/local/bin/habab-ha
COPY install-xiaomi-home.py /usr/local/bin/habab-install-xiaomi-home
COPY xiaomi-home-release.json /usr/local/bin/xiaomi-home-release.json
COPY opencode-release.json /opt/habab-opencode-bootstrap/opencode-release.json
COPY install-opencode-image.py /opt/habab-opencode-bootstrap/install-opencode-image.py

RUN mkdir -p /opt/habab-telegram/node_modules \
    && ln -s ../vendor/noxon-telegram /opt/habab-telegram/node_modules/noxon-telegram \
    && node --check /opt/habab-telegram/worker.mjs \
    && python3 /opt/habab-opencode-bootstrap/install-opencode-image.py \
         --arch "$TARGETARCH" --output-dir /opt/habab-opencode \
    && chmod 0755 /usr/local/bin/habab-home-entrypoint \
                  /usr/local/bin/habab-home-release-entrypoint \
                  /usr/local/bin/habab-ha \
                  /usr/local/bin/habab-install-xiaomi-home

ENTRYPOINT ["/usr/local/bin/habab-home-release-entrypoint"]
CMD ["/init"]

ENV HABAB_SOURCE_REVISION="${HABAB_SOURCE_REVISION}" \
    HABAB_SOURCE_DIRTY="false" \
    HABAB_OPENCODE_BINARY="/opt/habab-opencode/opencode"
