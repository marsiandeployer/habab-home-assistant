# Localhost-only on first start; set the server LAN address for other devices.
HABAB_HOME_BIND=127.0.0.1
TZ=Europe/Moscow
# Used only by the optional Zigbee Compose profile.
Z2M_SERIAL_DEVICE=/dev/ttyUSB0
# Required only for the optional Zigbee profile. Set distinct local credentials.
MQTT_USER=
MQTT_PASSWORD=
