+  shortcuts: [
+    { type: "summary", key: "light" },
+    { type: "custom", path: "/energy", label: "Energy" },
+  ],
+};
+
+const openPanel = async (
+  fetchImpl: (key?: string) => Promise<any>,
+  waitForLoad = true
+) => {
+  const { fetchFrontendSystemData } =
+    await import("../../../src/data/frontend");
