+    migration_in_progress: false,
+    migration_is_live: false,
+    recording: true,
+    thread_running: true,
+  };
+  const sendMessagePromise = vi.fn().mockResolvedValue(response);
+  return {
+    hass: {
+      config: { components },
+      connection: { sendMessagePromise },
+    } as unknown as HomeAssistant,
+    response,
+    sendMessagePromise,
+  };
+};
+
+describe("getRecorderInfoIfAvailable", () => {
+  it("does not request recorder info when recorder is absent", async () => {
+    const { hass, sendMessagePromise } = createHass([]);
+
+    await expect(getRecorderInfoIfAvailable(hass)).resolves.toBeUndefined();
+    expect(sendMessagePromise).not.toHaveBeenCalled();
+  });
+
+  it("keeps the recorder info response when recorder is enabled", async () => {
+    const { hass, response, sendMessagePromise } = createHass(["recorder"]);
+
+    await expect(getRecorderInfoIfAvailable(hass)).resolves.toBe(response);
+    expect(sendMessagePromise).toHaveBeenCalledWith({ type: "recorder/info" });
+  });
+
+  it("checks updated config so a late recorder load can request info", async () => {
+    const { hass, response, sendMessagePromise } = createHass([]);
+
+    await expect(getRecorderInfoIfAvailable(hass)).resolves.toBeUndefined();
+    expect(sendMessagePromise).not.toHaveBeenCalled();
+
+    hass.config.components.push("recorder");
+    await expect(getRecorderInfoIfAvailable(hass)).resolves.toBe(response);
+    expect(sendMessagePromise).toHaveBeenCalledTimes(1);
+  });
+
+  it("preserves errors from an enabled recorder request", async () => {
+    const { hass, sendMessagePromise } = createHass(["recorder"]);
+    const error = new Error("recorder request failed");
+    sendMessagePromise.mockRejectedValue(error);
+
+    await expect(getRecorderInfoIfAvailable(hass)).rejects.toBe(error);
+  });
+});
