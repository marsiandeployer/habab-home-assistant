diff --git a/test/habab/native-ui-bridge.test.ts b/test/habab/native-ui-bridge.test.ts
new file mode 100644
index 000000000..619fa155b
--- /dev/null
+++ b/test/habab/native-ui-bridge.test.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it, vi } from "vitest";
+import type { DataEntryFlowStep } from "../../src/data/data_entry_flow";
+import type { HomeAssistant } from "../../src/types";
+import { shouldHideAssistToolbarButton } from "../../src/habab/native-ui-bridge";
+
+describe("native Assist toolbar handoff", () => {
+  it("hides only for an admin when the assistant declares itself available", () => {
+    expect(shouldHideAssistToolbarButton(false, true)).toBe(false);
+    expect(shouldHideAssistToolbarButton(true, false)).toBe(false);
+    expect(shouldHideAssistToolbarButton(true, undefined)).toBe(false);
+    expect(shouldHideAssistToolbarButton(true, true)).toBe(true);
+  });
+
+  it("loads the native translated flow form and delegates its protected submit", async () => {
+    const loadBackendTranslation = vi.fn(async () => undefined);
+    const hass = {
+      loadFragmentTranslation: vi.fn(async () => undefined),
+      loadBackendTranslation,
+    } as unknown as HomeAssistant;
+    const initialStep = {
+      type: "form",
+      flow_id: "interaction-1",
+      handler: "example",
+      step_id: "user",
+      data_schema: [],
+    } as unknown as DataEntryFlowStep;
+    const nextStep = {
+      ...initialStep,
+      translation_domain: "shared",
+    } as DataEntryFlowStep;
+    const submit = vi.fn(
+      async (
+        _hass: HomeAssistant,
+        _interactionId: string,
+        _data: Record<string, unknown>
+      ) => nextStep
+    );
+
+    const result = await window.hababNativeUi!.loadFlowForm({
+      hass,
+      flowType: "config_flow",
+      handler: "example",
+      domain: "example",
+      step: initialStep,
+      submit,
+    });
+
+    expect(result.tag).toBe("step-flow-form");
+    expect(result.contextTag).toBe("habab-native-form-context");
+    expect(result.flowConfig.flowType).toBe("config_flow");
+    expect(customElements.get("step-flow-form")).toBeDefined();
+
+    await result.flowConfig.handleFlowStep(hass, "interaction-1", {
+      example_value: "safe",
+    });
+
+    expect(submit).toHaveBeenCalledWith(hass, "interaction-1", {
+      example_value: "safe",
+    });
+    expect(loadBackendTranslation).toHaveBeenCalledWith("config", "shared");
+  });
+});
