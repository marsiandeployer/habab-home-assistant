+export const registerGlobalDirtyStateProvider = (
+  provider: object
+): DirtyStateProviderRegistration => {
+  if (!provider || typeof provider !== "object") {
+    throw new TypeError("A dirty-state provider must be an object");
+  }
+  if (connectedDirtyStateProviders.has(provider)) {
+    throw new Error("Dirty-state provider is already registered");
+  }
+  connectedDirtyStateProviders.set(provider, false);
+  publishGlobalDirtyState();
+  let connected = true;
+  return {
+    setDirty: (isDirty) => {
+      if (!connected) {
+        return;
+      }
+      connectedDirtyStateProviders.set(provider, isDirty);
+      publishGlobalDirtyState();
+    },
+    unregister: () => {
+      if (!connected) {
+        return;
+      }
+      connected = false;
+      connectedDirtyStateProviders.delete(provider);
+      publishGlobalDirtyState();
+    },
+  };
 };
 
