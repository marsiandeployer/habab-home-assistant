+import { ContextProvider } from "@lit/context";
+import type { PropertyValues } from "lit";
+import { html } from "lit";
+import { customElement, property } from "lit/decorators";
+import type { HaForm } from "../components/ha-form/ha-form";
+import { narrowViewportContext } from "../data/context";
+import type { DataEntryFlowStep } from "../data/data_entry_flow";
+import type { FlowConfig } from "../dialogs/config-flow/show-dialog-data-entry-flow";
+import type { VoiceCommandDialogParams } from "../dialogs/voice-command-dialog/show-ha-voice-command-dialog";
+import { contextMixin } from "../state/context-mixin";
+import { HassBaseEl } from "../state/hass-base-mixin";
+import type { HomeAssistant } from "../types";
+
+interface NativeFlowFormOptionsBase {
+  hass: HomeAssistant;
+  handler: string;
+  domain: string;
+  step: DataEntryFlowStep;
+  submit: (
+    hass: HomeAssistant,
+    interactionId: string,
+    data: Record<string, unknown>
+  ) => Promise<DataEntryFlowStep>;
+}
+
+interface NativeFlowFormOptionsConfig extends NativeFlowFormOptionsBase {
+  flowType: "config_flow";
+  entryId?: string;
+}
+
+interface NativeFlowFormOptionsOptions extends NativeFlowFormOptionsBase {
+  flowType: "options_flow";
+  entryId: string;
+}
+
+type NativeFlowFormOptions =
+  NativeFlowFormOptionsConfig | NativeFlowFormOptionsOptions;
+
+interface NativeFlowFormResult {
+  tag: "step-flow-form";
+  contextTag: "habab-native-form-context";
+  flowConfig: FlowConfig;
+}
+
+export interface HababAssistantBridge {
+  readonly available?: boolean;
+  open(params: VoiceCommandDialogParams, opener: HTMLElement): boolean;
+}
+
+export interface HababNativeUiBridge {
+  readonly version: 1;
+  loadForm(): Promise<{ HaForm: typeof HaForm }>;
+  loadFlowForm(options: NativeFlowFormOptions): Promise<NativeFlowFormResult>;
+}
+
+class NativeFormContextHost extends HassBaseEl {
+  protected override _updateHass(_obj: Partial<HomeAssistant>): void {
+    // The context mixin publishes this data; the addon owns the hass property.
+  }
+}
+
+@customElement("habab-native-form-context")
+export class HababNativeFormContext extends contextMixin(
+  NativeFormContextHost
+) {
+  @property({ type: Boolean }) public narrow = false;
+
+  private _contextConnection?: HomeAssistant["connection"];
+
+  private _narrowViewportProvider = new ContextProvider(this, {
+    context: narrowViewportContext,
+    initialValue: this.narrow,
+  });
+
+  public connectedCallback(): void {
+    super.connectedCallback();
+    if (this.hass) {
+      this._syncContexts();
+    }
+  }
+
+  public disconnectedCallback(): void {
+    super.disconnectedCallback();
+    this._contextConnection = undefined;
+  }
+
+  protected willUpdate(changedProperties: PropertyValues<this>): void {
+    super.willUpdate(changedProperties);
+    if (changedProperties.has("narrow")) {
+      this._narrowViewportProvider.setValue(this.narrow);
+    }
+    if (changedProperties.has("hass") && this.hass) {
+      this._syncContexts();
+    }
+  }
+
+  protected render() {
+    return html`<slot></slot>`;
+  }
+
+  private _syncContexts(): void {
+    if (!this.hass) {
+      return;
+    }
+    if (this._contextConnection !== this.hass.connection) {
+      this.hassConnected();
+      this._contextConnection = this.hass.connection;
+    }
+    this._updateHass(this.hass);
+  }
+}
+
+declare global {
+  interface Window {
+    hababAssistant?: HababAssistantBridge;
+    hababNativeUi?: HababNativeUiBridge;
+  }
+}
+
+export const shouldHideAssistToolbarButton = (
+  isAdmin: boolean,
+  assistantAvailable: boolean | undefined
+): boolean => isAdmin && assistantAvailable === true;
+
+const loadNativeHaForm: HababNativeUiBridge["loadForm"] = async () => {
+  const form = await import("../components/ha-form/ha-form");
+  await Promise.all(
+    ["ha-form", "ha-selector"].map((tag) => customElements.whenDefined(tag))
+  );
+  return form;
+};
+
+const loadNativeFlowForm: HababNativeUiBridge["loadFlowForm"] = async ({
+  hass,
+  flowType,
+  handler,
+  domain,
+  entryId,
+  step,
+  submit,
+}) => {
+  await Promise.all([
+    import("../dialogs/config-flow/step-flow-form"),
+    customElements.whenDefined("habab-native-form-context"),
+  ]);
+
+  if (flowType === "config_flow") {
+    await Promise.all([
+      hass.loadFragmentTranslation("config"),
+      hass.loadBackendTranslation("config", handler),
+      hass.loadBackendTranslation("selector", handler),
+      hass.loadBackendTranslation("title", handler),
+    ]);
+  } else {
+    await Promise.all([
+      hass.loadFragmentTranslation("config"),
+      hass.loadBackendTranslation("options", domain),
+      hass.loadBackendTranslation("selector", domain),
+    ]);
+  }
+
+  const handleFlowStep = async (
+    currentHass: HomeAssistant,
+    interactionId: string,
+    data: Record<string, unknown>
+  ) => {
+    const nextStep = await submit(currentHass, interactionId, data);
+    const { loadFlowStepTranslations } =
+      await import("../dialogs/config-flow/show-dialog-data-entry-flow");
+    await loadFlowStepTranslations(currentHass, nextStep);
+    return nextStep;
+  };
+
+  let flowConfig: FlowConfig;
+  if (flowType === "config_flow") {
+    const { createConfigFlowConfig } =
+      await import("../dialogs/config-flow/show-dialog-config-flow");
+    flowConfig = createConfigFlowConfig(
+      { startFlowHandler: handler, entryId },
+      handleFlowStep
+    );
+  } else {
+    const { createOptionsFlowConfig } =
+      await import("../dialogs/config-flow/show-dialog-options-flow");
+    flowConfig = createOptionsFlowConfig(
+      { entry_id: entryId, domain },
+      handleFlowStep
+    );
+  }
+
+  const { loadFlowStepTranslations } =
+    await import("../dialogs/config-flow/show-dialog-data-entry-flow");
+  await loadFlowStepTranslations(hass, step);
+  await Promise.all([
+    customElements.whenDefined("step-flow-form"),
+    customElements.whenDefined("habab-native-form-context"),
+  ]);
+
+  return {
+    tag: "step-flow-form",
+    contextTag: "habab-native-form-context",
+    flowConfig,
+  };
+};
+
+window.hababNativeUi = Object.freeze({
+  version: 1,
+  loadForm: loadNativeHaForm,
+  loadFlowForm: loadNativeFlowForm,
+});
